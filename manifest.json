{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "version": "0.5.2",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "author": "Michael Ranner (azedo.at)",
  "applications": {
    "gecko": {
      "id": "mail-as-markdown@azedo.at",
      "strict_min_version": "102.0"
    }
  },
  "permissions": [
    "messagesRead",
    "accountsRead",
    "clipboardWrite",
    "menus"
  ],
  "background": {
    "scripts": [
      "turndown.js",
      "turndown-plugin-gfm.js",
      "html2md.js",
      "background.js"
    ]
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "64": "icon-64.png"
  },
  "browser_action": {
    "default_title": "__MSG_browserActionTitle__",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  }
}
